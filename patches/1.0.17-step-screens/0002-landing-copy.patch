From 2d741c53e26491d95e6448869afe8f2fbd850f07 Mon Sep 17 00:00:00 2001
From: Tamizz <andre.tamiazzo@gmail.com>
Date: Sat, 26 Sep 2026 19:00:34 +0000
Subject: [PATCH] Landing: new hero line with desktop, tablet and mobile icons
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

"Walk through any app once. DOM Studio captures every screen as real
HTML — desktop, tablet and mobile together, flows and a tree you can
rearrange, ready for Figma, Cursor or Claude." Each device word carries
the icon the View as control uses, and never wraps away from it. The line
is as wide as the URL field under it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LHBDQ31CR7gxkVwXtzjyZP
---
 renderer/index.html |  9 ++++++++-
 renderer/styles.css | 13 ++++++++++++-
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/renderer/index.html b/renderer/index.html
index 831ce45..024e3a6 100644
--- a/renderer/index.html
+++ b/renderer/index.html
@@ -202,7 +202,14 @@
             </div>
             <div id="import-browser">
               <h1 class="hero-title">Record the web as HTML</h1>
-              <p class="hero-sub">Capture the live page — markup, styles, and clicks — not a video of pixels.</p>
+              <p class="hero-sub">
+                Walk through any app once. DOM Studio captures every screen as real HTML —
+                <span class="hero-device"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>desktop</span>,
+                <span class="hero-device"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M11 18h2"/></svg>tablet</span>
+                and
+                <span class="hero-device"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10.5 5h3"/></svg>mobile</span>
+                together, flows and a tree you can rearrange, ready for Figma, Cursor or Claude.
+              </p>
               <div class="hero-url-field">
                 <span class="hero-url-scheme" aria-hidden="true">https://</span>
                 <input id="hero-url" class="hero-input" type="text" placeholder="Search or enter URL" spellcheck="false" autocomplete="off" />
diff --git a/renderer/styles.css b/renderer/styles.css
index afccad7..8413e83 100644
--- a/renderer/styles.css
+++ b/renderer/styles.css
@@ -1147,10 +1147,21 @@ select.tl-aspect {
 }
 .hero-sub {
   color: var(--text-muted);
-  max-width: 420px;
+  max-width: 480px;
   margin: 0;
   line-height: 1.45;
 }
+/* Device words in the landing line: the icon never wraps away from its word. */
+.hero-device {
+  white-space: nowrap;
+  color: var(--text);
+}
+.hero-device svg {
+  width: 1.1em;
+  height: 1.1em;
+  margin-right: 0.25em;
+  vertical-align: -0.2em;
+}
 .segmented.import-kind {
   width: 560px;
   max-width: 90%;
-- 
2.43.0

