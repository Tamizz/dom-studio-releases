+// --- Save screen now --------------------------------------------------------
+// Some pages never hold still — a hero word that keeps cycling, a demo that
+// types itself out, a consent banner that reloads the page — and their card
+// keeps saving. Save screen now ends the wait: desktop and phone are taken
+// exactly as they are at that moment, and that is the card. Later frames of
+// the same page don't write over it.
+const SAVE_NOW_PHONE_WAIT_MS = 4000; // the phone may still be opening the page
+const saveNowDesk = new Map(); // req → waiting take whose desktop this frame replaces
+const saveNowReqs = new Set(); // reqs of as-is takes (new cards)
+
+function saveScreenNow(it) {
+  if (!state.recording || !state.accepting || state.savingFlow || !it) return;
+  closeRecPreview();
+  // A saved card being redone: snap it again as it is now.
+  if (Number.isInteger(it.screen) && it.screen >= 0 && state.screens[it.screen]) {
+    if (liveViewportMatchesScreen(it.screen)) forceRecordViewport('screen', { replaceIdx: it.screen });
+    else refreshLiveScreen(it.screen);
+    return;
+  }
+  const admit = state.admittingTake;
+  const waiting = admit && !admit.mobileHtml && !admit.noMobile && takeNeedsLiveMobile(admit) ? admit : null;
+  // Its desktop is in and it waits on its phone.
+  if (waiting && (recRowAwaitingMobile(it) || sameTwinDoc(waiting.url, it.url))) {
+    toast('Saving this screen as it is now…');
+    saveTakeNow(waiting);
+    return;
+  }
+  // Its page is no longer on the desktop and nothing of it was taken: there is
+  // nothing to save now.
+  const desk = activeBrowseWebview();
+  if (desk && !sameTwinDoc(webviewUrlOrAttr(desk), it.url) && !recRowTakeIsIn(it)) {
+    dropRecItem(it);
+    renderRecScreens();
+    toast('That page isn’t open any more — open it again to save it.');
+    return;
+  }
+  // An earlier card still waits on its phone, and this one is held behind it:
+  // save that one now, then this one.
+  if (waiting) {
+    toast('Saving the screen before this one first…');
+    saveTakeNow(waiting).then(() => {
+      const next = state.admittingTake;
+      if (next && next !== waiting && !next.mobileHtml && (next.group === it.group || sameTwinDoc(next.url, it.url))) {
+        saveTakeNow(next);
+      }
+    });
+    return;
+  }
+  // The page hasn't settled yet: drop that wait, take both sides now.
+  forceRecordViewport('screen', { asIs: true });
+}
+
+// A take whose desktop is in and that waits on its phone: the phone as it is
+// now (once it shows this page), and the desktop again if it is still there.
+async function saveTakeNow(take) {
+  if (!take || take.mobileHtml || take.noMobile || take.saveNow) return;
+  take.saveNow = true;
+  take.keepAsIs = true;
+  const req = nextTwinReq();
+  const desk = activeBrowseWebview();
+  if (desk && desk !== el.webviewMobile && sameTwinDoc(webviewUrlOrAttr(desk), take.url) && !isLoadingMainFrame(desk)) {
+    saveNowDesk.set(req, take);
+    try {
+      desk.send('ds-snap', { as: 'screen', warm: false, req, screenParams: guestScreenParams() });
+    } catch {
+      saveNowDesk.delete(req);
+    }
+  }
+  const phone = el.webviewMobile;
+  const waiting = () => state.recording && state.admittingTake === take && !take.mobileHtml && !take.noMobile;
+  const phoneOnPage = () =>
+    !!phone && (browseSidesManual() || (sameTwinDoc(webviewUrlOrAttr(phone), take.url) && !isLoadingMainFrame(phone)));
+  // The walk may still be taking the phone there — let it move.
+  const t0 = Date.now();
+  while (waiting() && !phoneOnPage() && Date.now() - t0 < SAVE_NOW_PHONE_WAIT_MS) await waitMs(150);
+  let sentPhone = false;
+  let froze = false;
+  if (waiting() && phoneOnPage()) {
+    // Hold the phone on this page while it is snapped.
+    freezeTwinViewport(FORCE_MOBILE_RESEND_MS + 1000);
+    froze = true;
+    take.req = req;
+    twinForceFrames.set(req, null);
+    try {
+      phone.send('ds-snap', { as: 'screen', warm: false, req, screenParams: guestScreenParams() });
+      sentPhone = true;
+    } catch {
+      /* twin gone */
+    }
+    const t1 = Date.now();
+    while (waiting() && Date.now() - t1 < FORCE_MOBILE_RESEND_MS) await waitMs(150);
+  }
+  if (waiting()) {
+    giveUpMobile(
+      take,
+      'save now',
+      'Saved the desktop now — the phone wasn’t showing this page. Use Re-record → Mobile on this card.'
+    );
+  }
+  if (sentPhone) closePhoneJobCancelledBySnap();
+  twinLog('save now', take.name || take.url, 'mobile', !!take.mobileHtml);
+  if (froze) thawTwinViewport();
+  pumpMobileTwin();
+}
+
+// The desktop frame Save screen now asked for, for a take already waiting on
+// its phone (or saved a moment ago, if the phone answered first).
+function applySaveNowDesktop(s) {
+  const target = saveNowDesk.get(s.req);
+  saveNowDesk.delete(s.req);
+  if (!target || !s.html || target.kind === 'image') return;
+  const prevLen = (target.html || '').length;
+  const committed = state.screens.includes(target);
+  if (committed) {
+    if (state.screensBytes - prevLen + s.html.length > MAX_SCREENS_BYTES) return;
+    state.screensBytes += s.html.length - prevLen;
+  }
+  target.html = s.html;
+  for (const k of ['words', 'text', 'h1', 'title', 'sample', 'sig', 'baseSig', 'skey', 'w', 'h']) {
+    if (s[k] != null && s[k] !== '') target[k] = s[k];
+  }
+  target.ui = s.ui || '';
+  twinLog('save now: desktop as it is now', target.name || target.url, prevLen, '→', s.html.length);
+  if (committed) {
+    captureWebviewThumb().then((thumb) => {
+      if (thumb) target.thumb = thumb;
+      renderRecScreens();
+    });
+  }
+  renderRecScreens();
+}
+
+// A snap sent to the phone cancels whatever job the phone was running there
+// (its guest starts the new one at once). Close the twin job it was answering,
+// or the walk waits TWIN_JOB_STALL_MS for an answer that never comes.
+function closePhoneJobCancelledBySnap() {
+  if (!state.mobileTwinCapturing) return;
+  // Only the jobs Save screen now replaces: a waiting take's, or the phone
+  // following the desktop's link. A saved card's own job is left to the walk.
+  if (state.mobileTwinScreenIdx >= 0) return;
+  const phoneUrl = webviewUrlOrAttr(el.webviewMobile);
+  const job = state.mobileTwinCurrent || '';
+  // A job still opening its page on the phone had no snap running there.
+  if (job && phoneUrl && !sameTwinDoc(job, phoneUrl)) return;
+  twinLog('save now: closing the phone job the snap cancelled', job || phoneUrl);
+  finishMobileTwinUrl(job || phoneUrl);
+}
